{
  "name": "prime-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Independent desktop/web workbench for Prime Agent",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "selftest": "pnpm --filter @prime-workbench/gateway selftest",
    "postinstall": "node scripts/build-libs.mjs"
  },
