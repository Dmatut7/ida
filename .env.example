# Gateway bind (localhost by default; set HOST=0.0.0.0 only on a trusted LAN)
HOST=127.0.0.1
PORT=8787

# mock = full local demo without prime-agent
# rpc  = spawn prime-agent --mode rpc (JSONL over stdin/stdout)
PRIME_MODE=mock
# PRIME_MODE=rpc

# Real Prime Agent (Dmatut7/prime-agent-rlm, branch merge/repl-kernel)
PRIME_BIN=prime-agent
PRIME_CWD=.
# Space-separated extra args. Include --mode rpc. On the fork, also pin a socket:
PRIME_ARGS=--mode rpc --no-session
# PRIME_ARGS=--mode rpc --daemon-socket /tmp/prime-agent-ida/daemon.sock
PRIME_DAEMON_SOCKET=

# Voice. Empty OPENAI_API_KEY => mock barge-in (no cloud).
# VOICE_MODE=auto|mock|realtime
VOICE_MODE=auto
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Web (optional; default uses the Vite /ws proxy)
VITE_GATEWAY_URL=ws://127.0.0.1:8787/ws
VITE_GATEWAY_HTTP=http://127.0.0.1:8787
