# Gateway
PORT=8787
HOST=0.0.0.0
PRIME_MODE=mock
# PRIME_MODE=rpc
PRIME_BIN=prime-agent
PRIME_CWD=.
PRIME_ARGS=--mode rpc --no-session

# Voice (OpenAI Realtime). Empty key => mock voice with barge-in UX.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
VOICE_MODE=auto

# Web
VITE_GATEWAY_URL=ws://127.0.0.1:8787/ws
VITE_GATEWAY_HTTP=http://127.0.0.1:8787
