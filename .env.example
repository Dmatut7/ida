# Workbench bind
HOST=127.0.0.1
PORT=7788
WEB_PORT=5173

# mock = full local demo without prime-agent
# rpc  = spawn prime-agent --mode rpc (or attach a daemon-backed session)
PRIME_MODE=mock

# Real Prime Agent
PRIME_AGENT_BIN=prime-agent
# Extra args, space-separated. Always include --daemon-socket when using the
# Dmatut7/prime-agent-rlm fork so you do not attach an older supervisor.
# PRIME_AGENT_ARGS=--daemon-socket /tmp/prime-agent/daemon.sock
PRIME_DAEMON_SOCKET=
PRIME_SESSION_DIR=
PRIME_CWD=

# Optional localhost/LAN gate. Leave empty for trusted local use.
IDA_ACCESS_TOKEN=

# OpenAI Realtime (only for PRIME voice call mode = realtime)
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_REALTIME_VOICE=alloy

# Optional interactive PTY (falls back to a command runner)
IDA_PTY=0
